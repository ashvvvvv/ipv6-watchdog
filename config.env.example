# ==============================================================================
# ipv6-watchdog configuration (/opt/ipv6-watchdog/config.env, chmod 0600)
# ==============================================================================

# --- Cloudflare DNS (Required) ---
# Create a scoped API token with Zone -> DNS -> Edit permission for your zone only.
CF_TOKEN=your_cloudflare_api_token_here
CF_ZONE_ID=your_cloudflare_zone_id_here
CF_RECORD_ID=your_cloudflare_aaaa_record_id_here
DOMAIN=edge.example.com
DNS_TTL=60

# --- IPv6 /64 Subnet & Interface (Required) ---
IFACE=eth0
# First 4 hextets of your routed or on-link /64 prefix (e.g. 2001:db8:abcd:1234)
PREFIX64=2001:db8:abcd:1234
# System / management IPv6 addresses that will NEVER be deleted by the watchdog (comma-separated)
PRESERVE_IPV6=2001:db8:abcd:1234::2
# Proxy listening port probed from mainland China
PROXY_PORT=443

# --- Blocking Verdict & High-SLA Rotation Policy ---
# Minimum distinct CN carriers (Telecom/Unicom/Mobile) failing before triggering triage
FAIL_CARRIER_THRESHOLD=2
# Seconds to wait before re-checking current IPv6 after fresh random successor passes
RECHECK_DELAY_SECONDS=10
# Minimum seconds between automatic IPv6 rotations (default 30 min)
COOLDOWN_SECONDS=1800
# Hard cap on automatic rotations per 24h to prevent /64 subnet-wide escalation
MAX_SWITCHES_24H=3
# Grace period to keep old IPv6 alive after DNS switch so active connections drain cleanly
OLD_IP_GRACE_SECONDS=120
# Seconds to wait after binding a new IPv6 before NDP warmup ping
NDP_WARMUP_SECONDS=2

# --- Local Self-Heal (Pure Deterministic Checks) ---
# Comma-separated systemd services to verify & restart if down before blaming GFW
MONITOR_SERVICES=xray.service
# Set to 1 if you drop external IPv4 traffic on PROXY_PORT via /etc/nftables.conf
ENFORCE_NFT_DROP_V4=0

# --- Optional: Xray Sidecar Silent-Zero-Users Guard ---
# Leave blank if not using Xray gRPC API + external panel sidecar
XRAY_BIN=/usr/local/bin/xray
XRAY_API_ADDR=
XRAY_INBOUND_TAGS=
XRAY_SIDECAR_SERVICE=

# --- Optional: Globalping Free Auth Token (doubles quota 250 -> 500 probes/hr) ---
GLOBALPING_TOKEN=

# --- Optional: Real-Time Alerts ---
TG_BOT_TOKEN=
TG_CHAT_ID=
WEBHOOK_URL=
